# Production — use on the server with NODE_ENV=production, or set the same vars in your host (Railway, Fly, etc.).
# Replace secrets before deploy. Do not commit real passwords.
SUPABASE_URL=your
SUPABASE_SERVICE_ROLE_KEY=your
VITE_SUPABASE_URL=your
VITE_SUPABASE_ANON_KEY=your
# With both set, Google sign-in uses Supabase OAuth (redirect) — no GIS iframe / JavaScript origins on localhost.
# Supabase Dashboard → Authentication → URL Configuration: Site URL + Redirect URLs include http://localhost:3000 and production.
# Supabase → Auth → Providers → Google: same Web client id/secret as Google Cloud; redirect URI https://<project>.supabase.co/auth/v1/callback
SUPABASE_BOOK_IMAGES_PREFIX=your
SUPABASE_BOOK_IMAGES_BUCKET=your
# Production only (Vercel). Local dev: omit so Vite proxies /api to the API on :8787.
# VITE_API_URL=https://your-api.example.com

# Use the same project; use a strong DB password and consider restricting DB access to your API IPs if Supabase allows it.
DATABASE_URL=your
JWT_SECRET=your
# DATABASE_POOL_MAX=15
# DATABASE_SSL_INSECURE=0ch
# Same Web client id as Phygital-Backend GOOGLE_CLIENT_ID / VITE_GOOGLE_CLIENT_ID.
# Google Cloud → Credentials → Authorized JavaScript origins: http://localhost:3000, https://your-vercel-app.vercel.app
VITE_GOOGLE_CLIENT_ID=your
